<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>EpicJewels</RootNamespace>
    <AssemblyName>EpicJewels</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>10</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="AssetsEmbedded\EJConfig.yaml" />
    <None Remove="AssetsEmbedded\epicjewels" />
    <None Remove="Localizations\Bulgarian.json" />
    <None Remove="Localizations\Chinese.json" />
    <None Remove="Localizations\Chinese_Trad.json" />
    <None Remove="Localizations\Croatian.json" />
    <None Remove="Localizations\Czech.json" />
    <None Remove="Localizations\Danish.json" />
    <None Remove="Localizations\Dutch.json" />
    <None Remove="Localizations\English.json" />
    <None Remove="Localizations\Finnish.json" />
    <None Remove="Localizations\French.json" />
    <None Remove="Localizations\Georgian.json" />
    <None Remove="Localizations\German.json" />
    <None Remove="Localizations\Greek.json" />
    <None Remove="Localizations\Hindi.json" />
    <None Remove="Localizations\Hungarian.json" />
    <None Remove="Localizations\Icelandic.json" />
    <None Remove="Localizations\Italian.json" />
    <None Remove="Localizations\Japanese.json" />
    <None Remove="Localizations\Korean.json" />
    <None Remove="Localizations\Latvian.json" />
    <None Remove="Localizations\Lithuanian.json" />
    <None Remove="Localizations\Macedonian.json" />
    <None Remove="Localizations\Norwegian.json" />
    <None Remove="Localizations\Polish.json" />
    <None Remove="Localizations\Portuguese_Brazilian.json" />
    <None Remove="Localizations\Portuguese_European.json" />
    <None Remove="Localizations\Romanian.json" />
    <None Remove="Localizations\Russian.json" />
    <None Remove="Localizations\Serbian.json" />
    <None Remove="Localizations\Slovak.json" />
    <None Remove="Localizations\Spanish.json" />
    <None Remove="Localizations\Swedish.json" />
    <None Remove="Localizations\Thai.json" />
    <None Remove="Localizations\Turkish.json" />
    <None Remove="Localizations\Ukrainian.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AssetsEmbedded\EJConfig.yaml" />
    <EmbeddedResource Include="AssetsEmbedded\epicjewels" />
    <EmbeddedResource Include="Localizations\Bulgarian.json" />
    <EmbeddedResource Include="Localizations\Chinese.json" />
    <EmbeddedResource Include="Localizations\Chinese_Trad.json" />
    <EmbeddedResource Include="Localizations\Croatian.json" />
    <EmbeddedResource Include="Localizations\Czech.json" />
    <EmbeddedResource Include="Localizations\Danish.json" />
    <EmbeddedResource Include="Localizations\Dutch.json" />
    <EmbeddedResource Include="Localizations\English.json" />
    <EmbeddedResource Include="Localizations\Finnish.json" />
    <EmbeddedResource Include="Localizations\French.json" />
    <EmbeddedResource Include="Localizations\Georgian.json" />
    <EmbeddedResource Include="Localizations\German.json" />
    <EmbeddedResource Include="Localizations\Greek.json" />
    <EmbeddedResource Include="Localizations\Hindi.json" />
    <EmbeddedResource Include="Localizations\Hungarian.json" />
    <EmbeddedResource Include="Localizations\Icelandic.json" />
    <EmbeddedResource Include="Localizations\Italian.json" />
    <EmbeddedResource Include="Localizations\Japanese.json" />
    <EmbeddedResource Include="Localizations\Korean.json" />
    <EmbeddedResource Include="Localizations\Latvian.json" />
    <EmbeddedResource Include="Localizations\Lithuanian.json" />
    <EmbeddedResource Include="Localizations\Macedonian.json" />
    <EmbeddedResource Include="Localizations\Norwegian.json" />
    <EmbeddedResource Include="Localizations\Polish.json" />
    <EmbeddedResource Include="Localizations\Portuguese_Brazilian.json" />
    <EmbeddedResource Include="Localizations\Portuguese_European.json" />
    <EmbeddedResource Include="Localizations\Romanian.json" />
    <EmbeddedResource Include="Localizations\Russian.json" />
    <EmbeddedResource Include="Localizations\Serbian.json" />
    <EmbeddedResource Include="Localizations\Slovak.json" />
    <EmbeddedResource Include="Localizations\Spanish.json" />
    <EmbeddedResource Include="Localizations\Swedish.json" />
    <EmbeddedResource Include="Localizations\Thai.json" />
    <EmbeddedResource Include="Localizations\Turkish.json" />
    <EmbeddedResource Include="Localizations\Ukrainian.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="packages.config" />
    <None Include="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.26.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- JotunnLib's reference list still carries assemblies that Valheim's Unity version
         dropped. Nothing here uses them, and leaving them in warns MSB3245 every build. -->
    <Reference Remove="UnityEngine.ProfilerModule" Condition="!Exists('$(VALHEIM_MANAGED)/UnityEngine.ProfilerModule.dll')" />
  </ItemGroup>

  <PropertyGroup>
    <!-- VALHEIM_MANAGED and BEPINEX_PATH are resolved in ..\Directory.Build.props, which
         is evaluated before JotunnLib's package props and so wins the "only set this if it
         is still empty" race they use. Only fill in what is still missing here. -->
    <VALHEIM_MANAGED Condition=" '$(VALHEIM_MANAGED)' == '' ">$(VALHEIM_INSTALL)/valheim_Data/Managed</VALHEIM_MANAGED>
    <BEPINEX_PATH Condition=" '$(BEPINEX_PATH)' == '' ">$(VALHEIM_INSTALL)/BepInEx</BEPINEX_PATH>
    <UNITY_FOLDER>$(SolutionDir)EpicJewelsUnity</UNITY_FOLDER>
  </PropertyGroup>

  <Target Name="CopyToUnity">
    <Message Text="Copy assemblies to Unity" Importance="high" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/BepInEx.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/0Harmony.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/Mono.Cecil.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/MonoMod.Utils.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/MonoMod.RuntimeDetour.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)Jotunn.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <!-- mdb generation doesn't work from portable pdbs, which are the only kind supported under Linux -->
    <Copy Condition="Exists('$(TargetDir)$(TargetName).dll.mdb')" SourceFiles="$(TargetDir)$(TargetName).dll.mdb" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/Assembly-CSharp.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_valheim.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_utils.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_postprocessing.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_sunshafts.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_guiutils.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_lux.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_simplemeshcombine.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_googleanalytics.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/PlayFab.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/PlayFabParty.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/Splatform.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/Splatform.Steam.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/gui_framework.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/com.rlabrecque.steamworks.net.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/SoftReferenceableAssets.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
  </Target>

  <Target Name="JotunnPostBuildTask" AfterTargets="Build">
    <CallTarget Targets="CopyToUnity" Condition="Exists('$(UNITY_FOLDER)')" />
  </Target>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="xcopy &quot;$(ProjectDir)\..\EpicJewelsUnity\AssetBundles\StandaloneWindows\epicjewels&quot; &quot;$(ProjectDir)AssetsEmbedded\epicjewels&quot; /q /y /i&#xA;&#xA;" />
  </Target>
  <!-- BEGIN mod-tools (managed block; replaced by `mod-tools setup`) -->
  <PropertyGroup>
    <RepoRoot Condition=" '$(RepoRoot)' == '' ">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</RepoRoot>
    <!-- Override in the gitignored Environment.props when the gem's bindir
         is not on the PATH that MSBuild sees. -->
    <ModTools Condition=" '$(ModTools)' == '' ">mod-tools</ModTools>
  </PropertyGroup>

  <!-- Nothing is vendored into this repo, so a machine that never installed
       the tools has no mod-tools at all. This probes for it once and warns,
       rather than failing: not having a release tool should not stop anyone
       compiling. Everything below is then conditioned on the result, so a
       machine without it skips those steps instead of failing three times
       over with "command not found" buried in Exec output. -->
  <Target Name="ModToolsGuard" BeforeTargets="Build">
    <Exec Command="$(ModTools) preflight --root &quot;$(RepoRoot).&quot;" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ModToolsExit" />
    </Exec>
    <PropertyGroup>
      <ModToolsAvailable Condition=" '$(ModToolsExit)' == '0' ">true</ModToolsAvailable>
    </PropertyGroup>
    <Warning Condition=" '$(ModToolsAvailable)' != 'true' " Text="mod-tools is not installed on this machine, or this repo is not set up. Skipping release checks, packaging and deploy. Install it with `rake install` from a clone of the tools repo; see its SETUP.md." />
  </Target>

  <Target Name="ReleaseChecks" BeforeTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' AND '$(Configuration)' == 'Release' ">
    <Exec Command="$(ModTools) check --root &quot;$(RepoRoot).&quot;" />
  </Target>

  <Target Name="ReleasePackage" AfterTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' AND '$(Configuration)' == 'Release' ">
    <Exec Command="$(ModTools) package --root &quot;$(RepoRoot).&quot;" />
  </Target>

  <!-- No Configuration condition, unlike the two above: every build lands
       in the test profiles, Debug and Release alike. Declared last so it
       runs after a GenerateMdb target defined earlier in this file, whose
       .mdb it copies. Does nothing unless release.yml enables deploy. -->
  <Target Name="ModToolsDeploy" AfterTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' ">
    <Exec Command="$(ModTools) deploy --root &quot;$(RepoRoot).&quot; --configuration $(Configuration)" />
  </Target>
  <!-- END mod-tools -->
</Project>